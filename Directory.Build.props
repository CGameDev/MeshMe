<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Company>CGameDev / Brian Hinds</Company>
    <Product>Mesh Me360</Product>
    <RepositoryUrl>https://github.com/CGameDev/MeshMe</RepositoryUrl>
