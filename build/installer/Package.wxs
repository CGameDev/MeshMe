<!-- Current-user installation. Common mesh defaults and user documents are never overwritten. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Mesh Me360" Manufacturer="Computer Universal Technology Systems" Version="0.1.0" UpgradeCode="509B4F6D-CE66-493B-A973-4504203B8470" Scope="perUser" InstallerVersion="500" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Mesh Me360 is already installed." />
    <MediaTemplate EmbedCab="yes" MaximumUncompressedMediaSize="200" />
    <Property Id="WINDOWSBUILD"><RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" /></Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 10240)" Message="Mesh Me360 requires Windows 10 or 11 x64." />
    <Icon Id="ProductIcon" SourceFile="$(var.Repo)/src/MeshMe360.Desktop/Assets/MeshMe360.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/CGameDev/MeshMe" />
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="MeshMe360" /></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="Mesh Me360">
        <Component Id="StartMenu" Guid="189DBFD3-FBEE-4314-8D76-2DE888378C0B" Bitness="always64">
          <Shortcut Id="AppShortcut" Name="Mesh Me360" Target="[INSTALLFOLDER]MeshMe360.exe" WorkingDirectory="INSTALLFOLDER" Icon="ProductIcon" />
          <Shortcut Id="GuideShortcut" Name="Mesh Me360 User Guide" Target="[INSTALLFOLDER]Documentation\MeshMe360-User-Guide.pdf" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\MeshMe360\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Associations" Guid="EF82984D-9E38-48E6-B791-E9AD2A0B01DA" Bitness="always64">
        <RegistryValue Root="HKCU" Key="Software\Classes\MeshMe360.Project" Value="Mesh Me360 Project" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MeshMe360.Project\DefaultIcon" Value="&quot;[INSTALLFOLDER]MeshMe360.exe&quot;,0" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MeshMe360.Project\shell\open\command" Value="&quot;[INSTALLFOLDER]MeshMe360.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.mm360" Value="MeshMe360.Project" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\MeshMe360.exe\shell\open\command" Value="&quot;[INSTALLFOLDER]MeshMe360.exe&quot; &quot;%1&quot;" Type="string" />
        <?foreach Ext in .stl;.obj;.3mf;.step;.stp;.bumpmesh?>
        <RegistryValue Root="HKCU" Key="Software\Classes\$(var.Ext)\OpenWithProgids" Name="MeshMe360.Project" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\MeshMe360.exe\SupportedTypes" Name="$(var.Ext)" Value="" Type="string" />
        <?endforeach?>
      </Component>
    </DirectoryRef>
    <Feature Id="Application" Title="Mesh Me360" Level="1"><ComponentGroupRef Id="Payload" /><ComponentRef Id="StartMenu" /><ComponentRef Id="Associations" /></Feature>
    <!-- Microsoft requires these read/execute grants for Win10 AppContainer renderers. -->
    <CustomAction Id="GrantRuntimeAppPackages" Directory="SystemFolder" ExeCommand="&quot;[SystemFolder]icacls.exe&quot; &quot;[INSTALLFOLDER]WebView2FixedRuntime&quot; /grant *S-1-15-2-1:(OI)(CI)(RX)" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="GrantRuntimeRestrictedPackages" Directory="SystemFolder" ExeCommand="&quot;[SystemFolder]icacls.exe&quot; &quot;[INSTALLFOLDER]WebView2FixedRuntime&quot; /grant *S-1-15-2-2:(OI)(CI)(RX)" Execute="deferred" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="GrantRuntimeAppPackages" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="GrantRuntimeRestrictedPackages" After="GrantRuntimeAppPackages" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Generated)/License.rtf" />
  </Package>
</Wix>
