<Window x:Class="MeshMe360.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Mesh Me360" Icon="Assets/MeshMe360.ico" Width="1600" Height="900" MinWidth="1280" MinHeight="720">
 <Grid>
   <wv:WebView2 x:Name="Web" />
   <Border x:Name="StartupPanel" Background="#F3F4F6" Padding="40">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
       <TextBlock x:Name="StartupTitle" Text="Starting Mesh Me360…" FontSize="26" Margin="0,0,0,18" />
       <TextBlock x:Name="StartupMessage" Text="Loading the local mesh engine." TextWrapping="Wrap" />
       <TextBox x:Name="ErrorDetails" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,18,0,12" />
       <StackPanel x:Name="ErrorActions" Visibility="Collapsed" Orientation="Horizontal">
         <Button Content="Copy Details" Click="CopyDetails_Click" Padding="16,8" Margin="0,0,12,0" />
         <Button Content="Open Log Folder" Click="OpenLogs_Click" Padding="16,8" />
       </StackPanel>
     </StackPanel>
   </Border>
 </Grid>
</Window>
